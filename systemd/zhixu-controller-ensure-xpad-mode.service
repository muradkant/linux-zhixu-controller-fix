[Unit]
Description=Ensure ZhiXu controller uses Xbox/xpad mode
Documentation=https://github.com/muradkant/linux-zhixu-controller-fix
# Coldplug events are queued by this point; the udev rule handles devices that
# finish later or are connected after boot. Never pull the global settle wait.
After=systemd-udev-trigger.service
Before=display-manager.service
ConditionPathExists=/sys/module/usbcore/parameters/quirks

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/zhixu-controller-ensure-xpad-mode

[Install]
WantedBy=multi-user.target
