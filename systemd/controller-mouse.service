[Unit]
Description=Desktop-only Xbox controller mouse
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/antimicrox --hidden --no-tray --eventgen uinput --profile %h/.config/antimicrox/desktop.gamecontroller.amgp --profile-controller 030081b85e0400008e02000010010000
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
