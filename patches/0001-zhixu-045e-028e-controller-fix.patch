 {
+	bool is_zhixu = xpad_is_zhixu_360_clone(xpad);
+	int hat_x;
+	int hat_y;
+	int zhixu_dpad_x = 0;
+	int zhixu_dpad_y = 0;
+
 	/* valid pad data */
 	if (data[0] != 0x00)
 		return;
 
+	hat_x = !!(data[2] & 0x08) - !!(data[2] & 0x04);
+	hat_y = !!(data[2] & 0x02) - !!(data[2] & 0x01);
+	if (is_zhixu) {
+		__s16 old_lx = (__s16) le16_to_cpup((__le16 *)(data + 6));
+		__s16 old_ly = ~(__s16) le16_to_cpup((__le16 *)(data + 8));
+
+		if (old_lx > 16000)
+			zhixu_dpad_x = 1;
+		else if (old_lx < -16000)
+			zhixu_dpad_x = -1;
+
+		if (old_ly > 16000)
+			zhixu_dpad_y = 1;
+		else if (old_ly < -16000)
+			zhixu_dpad_y = -1;
+	}
+
