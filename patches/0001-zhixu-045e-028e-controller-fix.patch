+static bool xpad_is_zhixu_360_clone(struct usb_xpad *xpad)
+{
+	return xpad->udev->manufacturer &&
+	       strcasecmp("ZhiXu", xpad->udev->manufacturer) == 0 &&
+	       le16_to_cpu(xpad->udev->descriptor.idVendor) == 0x045e &&
+	       le16_to_cpu(xpad->udev->descriptor.idProduct) == 0x028e;
+}
