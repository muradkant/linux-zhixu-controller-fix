<?xml version="1.0" encoding="UTF-8"?>
<gamecontroller configversion="19" appversion="3.6.1">
    <sdlname>Xbox 360 Controller</sdlname>
    <guid>030081b85e0400008e02000010010000</guid>
    <profilename>Desktop Mouse</profilename>
    <names/>
    <sets>
        <set index="1">
            <name>Desktop Mouse</name>
            <stick index="1">
                <diagonalRange>65</diagonalRange>
                <stickbutton index="4">
                    <mousespeedx>20</mousespeedx>
                    <mousespeedy>20</mousespeedy>
                    <mouseacceleration>precision</mouseacceleration>
                </stickbutton>
                <stickbutton index="5">
                    <mousespeedx>20</mousespeedx>
                    <mousespeedy>20</mousespeedy>
                    <mouseacceleration>precision</mouseacceleration>
                    <slots>
                        <slot>
                            <code>2</code>
                            <mode>mousemovement</mode>
                        </slot>
                    </slots>
                </stickbutton>
                <stickbutton index="6">
                    <mousespeedx>20</mousespeedx>
                    <mousespeedy>20</mousespeedy>
                    <mouseacceleration>precision</mouseacceleration>
                </stickbutton>
                <stickbutton index="7">
                    <mousespeedx>20</mousespeedx>
                    <mousespeedy>20</mousespeedy>
                    <mouseacceleration>precision</mouseacceleration>
                    <slots>
                        <slot>
                            <code>3</code>
                            <mode>mousemovement</mode>
                        </slot>
                    </slots>
                </stickbutton>
                <stickbutton index="1">
                    <mousespeedx>20</mousespeedx>
                    <mousespeedy>20</mousespeedy>
                    <mouseacceleration>precision</mouseacceleration>
                    <slots>
                        <slot>
                            <code>1</code>
                            <mode>mousemovement</mode>
                        </slot>
                    </slots>
                </stickbutton>
                <stickbutton index="2">
                    <mousespeedx>20</mousespeedx>
                    <mousespeedy>20</mousespeedy>
                    <mouseacceleration>precision</mouseacceleration>
                </stickbutton>
                <stickbutton index="3">
                    <mousespeedx>20</mousespeedx>
                    <mousespeedy>20</mousespeedy>
                    <mouseacceleration>precision</mouseacceleration>
                    <slots>
                        <slot>
                            <code>4</code>
                            <mode>mousemovement</mode>
                        </slot>
                    </slots>
                </stickbutton>
                <stickbutton index="8">
                    <mousespeedx>20</mousespeedx>
                    <mousespeedy>20</mousespeedy>
                    <mouseacceleration>precision</mouseacceleration>
                </stickbutton>
            </stick>
            <stick index="2">
                <deadZone>8000</deadZone>
                <maxZone>32000</maxZone>
                <diagonalRange>65</diagonalRange>
                <stickbutton index="1">
                    <turbointerval>120</turbointerval>
                    <useturbo>true</useturbo>
                    <wheelspeedy>5</wheelspeedy>
                    <actionname>Scroll Up</actionname>
                    <slots>
                        <slot>
                            <code>4</code>
                            <mode>mousebutton</mode>
                        </slot>
                    </slots>
                </stickbutton>
                <stickbutton index="5">
                    <turbointerval>120</turbointerval>
                    <useturbo>true</useturbo>
                    <wheelspeedy>5</wheelspeedy>
                    <actionname>Scroll Down</actionname>
                    <slots>
                        <slot>
                            <code>5</code>
                            <mode>mousebutton</mode>
                        </slot>
                    </slots>
                </stickbutton>
            </stick>
            <dpad index="1">
                <dpadbutton index="1">
                    <turbointerval>120</turbointerval>
                    <useturbo>true</useturbo>
                    <wheelspeedy>5</wheelspeedy>
                    <actionname>Scroll Up</actionname>
                    <slots>
                        <slot>
                            <code>4</code>
                            <mode>mousebutton</mode>
                        </slot>
                    </slots>
                </dpadbutton>
                <dpadbutton index="4">
                    <turbointerval>120</turbointerval>
                    <useturbo>true</useturbo>
                    <wheelspeedy>5</wheelspeedy>
                    <actionname>Scroll Down</actionname>
                    <slots>
                        <slot>
                            <code>5</code>
                            <mode>mousebutton</mode>
                        </slot>
                    </slots>
                </dpadbutton>
            </dpad>
            <trigger index="1">
                <triggerbutton index="2">
                    <actionname>Right Click</actionname>
                    <slots>
                        <slot>
                            <code>3</code>
                            <mode>mousebutton</mode>
                        </slot>
                    </slots>
                </triggerbutton>
            </trigger>
            <trigger index="2">
                <triggerbutton index="2">
                    <actionname>Left Click</actionname>
                    <slots>
                        <slot>
                            <code>1</code>
                            <mode>mousebutton</mode>
                        </slot>
                    </slots>
                </triggerbutton>
            </trigger>
            <button index="1">
                <actionname>Left Click</actionname>
                <slots>
                    <slot>
                        <code>1</code>
                        <mode>mousebutton</mode>
                    </slot>
                </slots>
            </button>
            <button index="2">
                <actionname>Right Click</actionname>
                <slots>
                    <slot>
                        <code>3</code>
                        <mode>mousebutton</mode>
                    </slot>
                </slots>
            </button>
            <button index="3">
                <actionname>Middle Click</actionname>
                <slots>
                    <slot>
                        <code>2</code>
                        <mode>mousebutton</mode>
                    </slot>
                </slots>
            </button>
            <button index="5">
                <actionname>Escape</actionname>
                <slots>
                    <slot>
                        <code>0x1000000</code>
                        <mode>keyboard</mode>
                    </slot>
                </slots>
            </button>
            <button index="7">
                <actionname>Enter</actionname>
                <slots>
                    <slot>
                        <code>0x1000004</code>
                        <mode>keyboard</mode>
                    </slot>
                </slots>
            </button>
        </set>
    </sets>
</gamecontroller>
